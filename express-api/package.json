{
  "main": "serverless.ts",
  "scripts": {
    "test": "jest",
    "build": "pnpm build:types && pnpm build:es",
    "build:types": "tsc --emitDeclarationOnly",
    "build:es": "esbuild src/node-server.ts --bundle --platform=node --target=node20 --outdir=out",
    "build-fastify": "esbuild src/fastify-app/server.ts --bundle --platform=node --target=node20 --outdir=out-fastify --external:@fastify/swagger-ui --sourcemap",
    "dev": "nodemon --watch src --ext ts --exec 'pnpm build:es && pnpm start'",
    "dev-fastify": "nodemon --watch src/fastify-app --ext ts --exec 'pnpm build-fastify && pnpm start-fastify'",
    "generate-kysely-types": "kysely-codegen --out-file generated/kysely.d.ts --exclude-pattern hdb_* --env-file .env.local --dialect postgres",
    "start": "node out/node-server.js",
    "start-fastify": "node out-fastify/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.631.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.1.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@h4ad/serverless-adapter": "^4.3.0",
    "@sentry/serverless": "^7.118.0",
    "@sinclair/typebox": "^0.33.12",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv-safe": "^8.2.0",
    "express": "^4.19.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "fp-ts": "^2.16.9",
    "http-status": "^1.7.4",
    "io-ts": "^2.2.21",
    "jose": "^5.6.3",
    "kysely": "^0.27.4",
    "lodash": "^4.17.21",
    "mongodb": "^6.8.0",
    "morgan": "^1.10.0",
    "nanoid": "^5.0.7",
    "ofetch": "^1.3.4",
    "pg": "^8.13.0",
    "serverless-http": "^3.2.0",
    "slugify": "^1.6.6",
    "typera-express": "^2.4.4"
  },
  "devDependencies": {
    "@serverless/typescript": "^3.38.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.23.0",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.16.8",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.52.1",
    "serverless-offline": "^13.6.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "urllib": "^3.27.0"
  }
}
