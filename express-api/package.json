{
  "type": "module",
  "main": "src/fastify-app/server.ts",
  "scripts": {
    "test": "node --loader=ts-node/esm --test 'e2e/**/*.test.ts'",
    "test:watch": "node --loader=ts-node/esm --test --watch 'e2e/**/*.test.ts'",
    "test:coverage": "node --loader=ts-node/esm --test --experimental-test-coverage 'e2e/**/*.test.ts'",
    "test:verbose": "node --loader=ts-node/esm --test --test-reporter=verbose 'e2e/**/*.test.ts'",
    "build": "esbuild src/fastify-app/server.ts --bundle --platform=node --target=node20 --outdir=out-fastify --external:@fastify/swagger-ui --sourcemap",
    "dev": "nodemon --watch src/fastify-app --ext ts --exec 'pnpm build && pnpm start'",
    "generate-kysely-types": "kysely-codegen --out-file generated/kysely.d.ts --exclude-pattern hdb_* --env-file .env.local --dialect postgres",
    "start": "node out-fastify/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.1.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@sinclair/typebox": "^0.33.12",
    "dotenv-safe": "^8.2.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "kysely": "^0.27.4",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.23.0",
    "kysely-codegen": "^0.16.8",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
