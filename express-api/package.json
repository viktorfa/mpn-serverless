{
  "type": "module",
  "main": "src/fastify-app/server.ts",
  "scripts": {
    "dev": "tsx watch src/fastify-app/server.ts",
    "test": "tsx --test $(find e2e -name '*.test.ts' -type f)",
    "test:unit": "tsx --test $(find e2e/unit -name '*.test.ts' -type f)",
    "test:integration": "tsx --test $(find e2e/integration -name '*.test.ts' -type f)",
    "build": "tsup src/fastify-app/server.ts --format esm --sourcemap --out-dir dist && tsup src/instrumentation/otel.ts --format esm --sourcemap --out-dir dist",
    "start": "node --import ./dist/otel.js dist/server.js",
    "typecheck": "tsc --noEmit",
    "generate-kysely-types": "kysely-codegen --out-file generated/kysely.d.ts --exclude-pattern hdb_* --env-file .env.local --dialect postgres"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/env": "^5.0.2",
    "@fastify/otel": "^0.9.4",
    "@fastify/swagger": "^9.1.0",
    "@fastify/swagger-ui": "^5.0.1",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.64.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@sinclair/typebox": "^0.33.12",
    "dotenv": "^17.2.2",
    "dotenv-safe": "^8.2.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "kysely": "^0.27.4",
    "pg": "^8.13.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.23.0",
    "kysely-codegen": "^0.16.8",
    "nodemon": "^3.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4"
  }
}
